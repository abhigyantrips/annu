# Choose a unique administrator password of at least 12 characters.
# Single-quote values containing $ or # when using Docker Compose's .env format.
ADMIN_PASSWORD=
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/annu.db
# Enable only behind a trusted, access-restricted Cloudflare proxy chain.
TRUST_CLOUDFLARE_HEADERS=false
# 0 keeps everything forever; otherwise at least 366 days.
RETENTION_DAYS=400
# Optional. A random signing key is persisted beside the database if omitted.
# SESSION_SECRET=
